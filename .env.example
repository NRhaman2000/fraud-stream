# Copy to .env and change every value marked CHANGE ME.  `.env` is git-ignored.

# --- logging (all services)
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json

# --- Kafka.  Inside compose the broker is kafka:9092; from your laptop it is localhost:29092.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_CLIENT_ID_PREFIX=fraud-stream
KAFKA_ADMIN_TIMEOUT_S=15

# --- Postgres.  Inside compose the host is postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fraud
POSTGRES_USER=fraud
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
# The dashboard logs in as this user, which may only read, add and update alerts.
POSTGRES_APP_USER=fraud_app
POSTGRES_APP_PASSWORD=CHANGE_ME_app_password
POSTGRES_CONNECT_TIMEOUT_S=5

# --- producer (Phase 4)
# 1..10000
PRODUCER_RATE_TPS=1000
# simulated chargeback delay
PRODUCER_LABEL_DELAY_S=10
# replay the test set forever
PRODUCER_LOOP=true

# --- scorer (Phase 4)
SCORER_MODEL_API_URL=http://model-api:8001
# 1..512
SCORER_BATCH_MAX=256
# max wait to fill a batch
SCORER_BATCH_WAIT_MS=5
SCORER_REQUEST_TIMEOUT_MS=2000
SCORER_RETRY_MAX_BACKOFF_MS=2000
# batches at the model API at once (pipelining)
SCORER_MAX_INFLIGHT=2

# --- model API (Phase 4).  At least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(32))"
MODEL_API_MODEL_DIR=/app/models
MODEL_API_API_KEY=CHANGE_ME_generate_a_random_key_of_32_chars_or_more
MODEL_API_MAX_BATCH=512
# XGBoost threads; keep at or below the model-api CPU limit in docker-compose.yml
MODEL_API_THREADS=2

# --- dashboard (Phase 4)
DASHBOARD_STATS_WINDOW_S=60
DASHBOARD_PUSH_INTERVAL_S=1

# --- Grafana admin login (http://localhost:3000)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password
